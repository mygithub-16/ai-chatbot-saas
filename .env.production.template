# Production Environment Configuration Template
# Copy these key-value pairs into your cloud host's Environment Variables setting (e.g., Render Dashboard -> Environment)

# Environment Mode
ENVIRONMENT=production

# Database URL
# For Render with Persistent Disk:
DATABASE_URL=sqlite:////app/data/chatbot_saas.db
# For PostgreSQL (e.g. Supabase / Neon):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# AI Models & Keys
OPENAI_API_KEY=sk-proj-YOUR_ACTUAL_OPENAI_KEY
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Admin Security & Credentials (CHANGE THESE FOR PRODUCTION)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=SetAStrongAdminPasswordHere!2026
ADMIN_TOKEN_SECRET=8f9a2b4c6e1d3a5b7c9e1f3a5b7c9e1f3a5b7c9e1f3a5b7c9e1f3a5b7c9e1f3a
ADMIN_DASHBOARD_SECRET=3a5b7c9e1f3a5b7c9e1f3a5b7c9e1f3a5b7c9e1f3a5b7c9e1f3a5b7c9e1f3a5b
ADMIN_TOKEN_TTL_SECONDS=86400

# Security & CORS Settings (Include your live web domain and Render URL)
ALLOWED_ORIGINS=https://ai-chatbot-saas.onrender.com,https://yourcustomdomain.com
RATE_LIMIT_PER_MINUTE=60

# Paystack Payment Gateway (Live or Test secret key)
PAYSTACK_SECRET_KEY=sk_live_YOUR_PAYSTACK_SECRET_KEY

# Google Calendar Integration (OAuth 2.0 Client Credentials)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://ai-chatbot-saas.onrender.com/auth/google-calendar/callback
